rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/admin_users/$(request.auth.token.email));
    }

    match /admin_users/{adminEmail} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /teachers/{teacherEmail} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /TeacherProfile/{teacherEmail} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || (request.auth != null && request.auth.token.email == teacherEmail);
    }

    match /students/{studentEmail} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || (request.auth != null && request.auth.token.email.matches('.*@vsa\\.edu\\.hk$'));
    }

    match /sets/{setId} {
      allow read, write: if request.auth != null && (isAdmin() || request.auth.token.email == resource.data.owner || request.auth.token.email == request.resource.data.owner);
    }
    
    match /dd_folder_systems/{systemId} {
      allow read, write: if request.auth != null && (isAdmin() || request.auth.token.email.matches('.*@vsa\\.edu\\.hk$'));
    }

    match /dd_student_folders/{folderId} {
      allow read, write: if request.auth != null && (isAdmin() || request.auth.token.email.matches('.*@vsa\\.edu\\.hk$'));
    }

    match /dd_distributions/{distributionId} {
      allow read, write: if request.auth != null && (isAdmin() || request.auth.token.email.matches('.*@vsa\\.edu\\.hk$'));
    }

    match /dd_distributed_files/{fileId} {
      allow read, write: if request.auth != null && (isAdmin() || request.auth.token.email.matches('.*@vsa\\.edu\\.hk$'));
    }
    
    function isStaff() {
      return request.auth != null && request.auth.token.email_verified == true &&
             request.auth.token.email.matches('.*@vsa\\.edu\\.hk$');
    }

    function validContact() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'position', 'email', 'phone', 'organisationId', 'organisation', 'addedBy', 'dateAdded', 'notes', 'tags', 'visibility'])
             && d.keys().hasAll(['name', 'addedBy', 'dateAdded', 'visibility'])
             && d.name is string && d.name.size() > 0 && d.name.size() <= 200
             && d.addedBy == request.auth.token.email
             && d.visibility in ['private', 'shared']
             && (!('notes' in d) || (d.notes is string && d.notes.size() <= 5000))
             && (!('tags' in d) || (d.tags is list && d.tags.size() <= 20));
    }

    // Community Contacts: private contacts are only visible to their owner; shared ones to all staff.
    match /cc_contacts/{contactId} {
      allow read: if isStaff() && (resource.data.addedBy == request.auth.token.email || resource.data.visibility == 'shared');
      allow create: if isStaff() && validContact();
      allow update: if isStaff() && resource.data.addedBy == request.auth.token.email && validContact();
      allow delete: if isStaff() && (resource.data.addedBy == request.auth.token.email || isAdmin());
    }

    match /cc_organisations/{orgId} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.keys().hasOnly(['orgName', 'orgType', 'tag', 'createdBy'])
                       && request.resource.data.createdBy == request.auth.token.email
                       && request.resource.data.orgName is string && request.resource.data.orgName.size() > 0 && request.resource.data.orgName.size() <= 200;
      allow update, delete: if isStaff() && (resource.data.createdBy == request.auth.token.email || isAdmin());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
